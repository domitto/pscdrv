      <precision>0</precision>
      <show_units>false</show_units>
      <rules>
        <rule name="RedIfNonzero" prop_id="foreground_color" out_exp="false">
          <exp bool_exp="pv0==0">
            <value>
              <color red="100" green="220" blue="120">
              </color>
            </value>
          </exp>
          <exp bool_exp="pv0&gt;0">
            <value>
              <color red="230" green="70" blue="70">
              </color>
            </value>
          </exp>
          <pv_name>pva://TST:DropTotal-I</pv_name>
        </rule>
      </rules>
    </widget>
