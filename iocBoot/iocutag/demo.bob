    <widget type="textupdate" version="2.0.0">
      <name>ValueBig</name>
      <pv_name>pva://TST:Val-I</pv_name>
      <x>12</x>
      <y>28</y>
      <width>276</width>
      <height>70</height>
      <font>
        <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
        </font>
      </font>
      <foreground_color>
        <color red="231" green="235" blue="240">
        </color>
      </foreground_color>
      <background_color>
        <color red="23" green="27" blue="34">
        </color>
      </background_color>
      <precision>0</precision>
      <show_units>false</show_units>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <rules>
        <rule name="ColorBySource" prop_id="foreground_color" out_exp="false">
          <exp bool_exp="pv0==111">
            <value>
              <color name="SourceA" red="255" green="180" blue="84">
              </color>
            </value>
          </exp>
          <exp bool_exp="pv0==222">
            <value>
              <color name="SourceB" red="79" green="209" blue="197">
              </color>
            </value>
          </exp>
          <pv_name>pva://TST:Val-I</pv_name>
        </rule>
      </rules>
    </widget>
